@model List<MusicPlatform.Shared.DTOs.Song.SongListDto>
@{
    var title = ViewData["AlbumTitle"] as string ?? "Albüm";
    ViewData["Title"] = title;
    var artist = Model.FirstOrDefault()?.ArtistName;
    var artistId = Model.FirstOrDefault()?.ArtistId;
}

<div class="page-container padding">

    <div class="mb-4">
        <div class="text-muted text-sm mb-1">ALBÜM</div>
        <h4 class="text-white mb-1">@title</h4>
        @if (artist is not null && artistId is not null)
        {
            <a asp-controller="Artists" asp-action="Detail" asp-route-id="@artistId" class="text-muted">@artist</a>
        }
    </div>

    @if (Model.Any())
    {
        <div class="row" data-playlist="album-songs">
            @foreach (var song in Model)
            {
                <partial name="_SongCard" model="song" />
            }
        </div>
    }
    else
    {
        <div class="empty-state">Bu albümde şarkı yok.</div>
    }

</div>