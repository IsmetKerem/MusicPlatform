@model MusicPlatform.UI.Models.HomeViewModel
@inject CurrentUser CurrentUser
@{
    ViewData["Title"] = "Keşfet";

    var hour = DateTime.Now.Hour;
    var greet = hour < 6 ? "İyi geceler" : hour < 12 ? "Günaydın" : hour < 18 ? "İyi günler" : "İyi akşamlar";
    var firstName = CurrentUser.FullName.Split(' ')[0];
    var tierNames = new[] { "Basic", "Gold", "Premium", "Elit" };
}

<div class="page-container padding">

    @* ═══════════════════════════════ Karşılama + katalog kilidi *@
    <div class="unlock-panel">

        <div>
            <div class="unlock-eyebrow">@greet</div>
            <h1 class="unlock-greet">@firstName</h1>
        </div>

        <div class="unlock-meter">
            <div class="unlock-count">
                <b>@Model.UnlockedSongs</b>
                <span>/ @Model.TotalSongs şarkı @CurrentUser.PackageName paketinde açık</span>
            </div>

            <div class="unlock-track">
                @for (var lvl = 1; lvl <= 4; lvl++)
                {
                    <div class="unlock-seg @(CurrentUser.PackageLevel >= lvl ? "on" : "")"
                         title="@tierNames[lvl - 1] · @Model.TierCounts.GetValueOrDefault(lvl) şarkı"
                         style="--seg-color:var(--tier-@lvl);--seg-delay:@(lvl * 0.08)s"></div>
                }
            </div>

            <div class="unlock-legend">
                @for (var lvl = 1; lvl <= 4; lvl++)
                {
                    <span class="@(CurrentUser.PackageLevel >= lvl ? "on" : "")">@tierNames[lvl - 1]</span>
                }
            </div>
        </div>

        @if (CurrentUser.PackageLevel < 4)
        {
            <div>
                <a asp-controller="Packages" asp-action="Index"
                   class="btn btn-outline-primary btn-rounded px-4">Paketini yükselt</a>
            </div>
        }

    </div>

    @* ═══════════════════════════════════════════════ Sana özel *@
    @if (Model.Recommendations.Any())
    {
        <div class="section-head">
            <h5>Sana özel</h5>
            <span class="note">dinleme geçmişine göre</span>
            <span class="rule"></span>
        </div>

        <div class="row" data-playlist="recommendations">
            @foreach (var song in Model.Recommendations)
            {
                <partial name="_SongCard" model="@((SongListDto)song)" />
            }
        </div>

        <div class="section-gap"></div>
    }

    @* ══════════════════════════════════════════════════ Popüler *@
    @if (Model.Popular.Any())
    {
        <div class="section-head">
            <h5>En çok dinlenenler</h5>
            <span class="rule"></span>
            <a asp-controller="Songs" asp-action="Index" asp-route-sortBy="2" class="more">Tümünü gör →</a>
        </div>

        <div class="row" data-playlist="popular">
            @foreach (var song in Model.Popular)
            {
                <partial name="_SongCard" model="song" />
            }
        </div>

        <div class="section-gap"></div>
    }

    @* ════════════════════════════════════════════════════ Türler *@
    @if (Model.Genres.Any())
    {
        <div class="section-head">
            <h5>Türler</h5>
            <span class="rule"></span>
            <a asp-controller="Genres" asp-action="Index" class="more">Tümünü gör →</a>
        </div>

        <div class="row">
            @foreach (var genre in Model.Genres)
            {
                <div class="col-6 col-md-4 col-lg-3 mb-3">
                    <a asp-controller="Genres" asp-action="Detail" asp-route-id="@genre.Id"
                       class="genre-tile" style="--g-color:@genre.ColorHex">
                        <div class="genre-tile-name">@genre.Name</div>
                        <div class="genre-tile-count">@genre.SongCount şarkı</div>
                    </a>
                </div>
            }
        </div>

        <div class="section-gap"></div>
    }

    @* ══════════════════════════════════════════ Yeni eklenenler *@
    @if (Model.Newest.Any())
    {
        <div class="section-head">
            <h5>Yeni eklenenler</h5>
            <span class="rule"></span>
        </div>

        <div class="row" data-playlist="newest">
            @foreach (var song in Model.Newest)
            {
                <partial name="_SongCard" model="song" />
            }
        </div>
    }

    @if (!Model.Popular.Any() && !Model.Newest.Any())
    {
        <div class="empty-state">
            <div class="h5 mb-2">Katalog boş</div>
            <div>API tarafında seed verisinin yüklendiğinden emin ol.</div>
        </div>
    }

</div>