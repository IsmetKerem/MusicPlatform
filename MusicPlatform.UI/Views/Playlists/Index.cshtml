@model MusicPlatform.UI.Models.PlaylistPageViewModel
@{
    ViewData["Title"] = "Playlistlerim";
}

<div class="page-container padding">

    <div class="d-flex align-items-center mb-4">
        <div>
            <h4 class="text-white mb-1">Playlistlerim</h4>
            <div class="text-muted text-sm">@Model.Playlists.Count playlist</div>
        </div>
        <span class="flex"></span>
        <button class="btn btn-primary btn-rounded px-4" data-toggle="modal" data-target="#createPlaylistModal">
            <i data-feather="plus" style="width:16px;height:16px"></i>
            <span class="ml-2">Yeni playlist</span>
        </button>
    </div>

    @if (Model.Playlists.Any())
    {
        <div class="row">
            @foreach (var pl in Model.Playlists)
            {
                <div class="col-6 col-md-4 col-lg-3 mb-4">
                    <a asp-action="Detail" asp-route-id="@pl.Id" class="playlist-card d-block">

                        <div class="playlist-cover mb-2"
                             style="@CoverHelper.GradientStyle(pl.Name)">
                            <i data-feather="music" class="playlist-cover-icon"></i>
                            <div class="playlist-cover-count">@pl.SongCount</div>
                        </div>

                        <div class="text-white text-ellipsis">@pl.Name</div>
                        <div class="text-muted text-xs">
                            @pl.SongCount şarkı
                            @if (pl.TotalDurationSeconds > 0)
                            {
                                <span class="mx-1">·</span>
                                <span>@FormatDuration(pl.TotalDurationSeconds)</span>
                            }
                            @if (pl.IsPublic)
                            {
                                <span class="mx-1">·</span><span>herkese açık</span>
                            }
                        </div>
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="h5 text-white mb-2">Henüz playlist'in yok</div>
            <div class="mb-3">Sevdiğin şarkıları bir araya getir.</div>
            <button class="btn btn-primary btn-rounded px-4" data-toggle="modal" data-target="#createPlaylistModal">
                İlk playlist'ini oluştur
            </button>
        </div>
    }

</div>

@* -------------------------------------------------- Yeni playlist modal *@
<div class="modal fade" id="createPlaylistModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark">

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header border-0">
                    <h6 class="modal-title text-white">Yeni playlist</h6>
                    <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                </div>

                <div class="modal-body">
                    <div class="form-group">
                        <label asp-for="New.Name"></label>
                        <input asp-for="New.Name" class="form-control" placeholder="Örn. Çalışırken dinlediklerim" />
                    </div>

                    <div class="form-group">
                        <label asp-for="New.Description"></label>
                        <textarea asp-for="New.Description" class="form-control" rows="2"
                                  placeholder="İsteğe bağlı"></textarea>
                    </div>

                    <label class="ui-check m-0 text-sm text-muted d-flex align-items-center">
                        <input asp-for="New.IsPublic" type="checkbox" />
                        <i></i> Herkese açık olsun
                    </label>
                </div>

                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-sm text-muted" data-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary btn-rounded px-4">Oluştur</button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Styles {
    <style>
        .playlist-cover {
            position: relative;
            padding-top: 100%;
            border-radius: 8px;
            background: linear-gradient(135deg, var(--lc-from, #6C4DF6), var(--lc-to, #2D1B69));
            overflow: hidden;
            transition: transform .25s;
        }

        .playlist-card:hover .playlist-cover { transform: scale(1.03); }

        .playlist-cover-icon {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            width: 44px; height: 44px;
            color: rgba(255,255,255,.75);
        }

        .playlist-cover-count {
            position: absolute;
            right: 10px; bottom: 8px;
            font-size: 11px;
            color: rgba(255,255,255,.6);
        }

        .playlist-card:hover .text-white { color: #6c4df6 !important; }
    </style>
}

@functions {
    string FormatDuration(int seconds)
    {
        var t = TimeSpan.FromSeconds(seconds);
        return t.TotalHours >= 1
            ? $"{(int)t.TotalHours} sa {t.Minutes} dk"
            : $"{t.Minutes} dk";
    }
}