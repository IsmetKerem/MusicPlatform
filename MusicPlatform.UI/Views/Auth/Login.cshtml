@model MusicPlatform.UI.Models.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "_AuthLayout";
}

<h2>Tekrar hoş geldin</h2>
<div class="lede">Hesabına giriş yap, kaldığın yerden devam et.</div>

<form asp-action="Login" method="post" data-auth-form>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ReturnUrl" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="auth-alert auth-alert-error">
            <div asp-validation-summary="ModelOnly"></div>
        </div>
    }

    <div class="auth-row">
        <div class="field">
            <input asp-for="Email" type="email" placeholder=" " autocomplete="email" autofocus />
            <label asp-for="Email">E-posta</label>
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
    </div>

    <div class="auth-row">
        <div class="field">
            <input asp-for="Password" type="password" placeholder=" " autocomplete="current-password" />
            <label asp-for="Password">Şifre</label>
            <button type="button" class="peek" tabindex="-1" aria-label="Şifreyi göster"></button>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
    </div>

    <div class="auth-aux">
        <a asp-action="ForgotPassword">Şifremi unuttum</a>
    </div>

    <button type="submit" class="auth-submit">
        <span class="label">Giriş yap</span>
        <span class="spin"></span>
    </button>

    <div class="auth-alt">
        Hesabın yok mu? <a asp-action="Register">Kayıt ol</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}