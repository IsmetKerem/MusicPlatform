@model MusicPlatform.UI.Models.RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = "_AuthLayout";
}

<h2>Aramıza katıl</h2>
<div class="lede">Ücretsiz Basic paketle hemen dinlemeye başla.</div>

<form asp-action="Register" method="post" data-auth-form>
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="auth-alert auth-alert-error">
            <div asp-validation-summary="ModelOnly"></div>
        </div>
    }

    <div class="auth-row">
        <div class="row no-gutters">
            <div class="col-6 pr-2">
                <div class="field">
                    <input asp-for="FirstName" placeholder=" " autocomplete="given-name" autofocus />
                    <label asp-for="FirstName">Ad</label>
                    <span asp-validation-for="FirstName" class="field-error"></span>
                </div>
            </div>
            <div class="col-6 pl-2">
                <div class="field">
                    <input asp-for="LastName" placeholder=" " autocomplete="family-name" />
                    <label asp-for="LastName">Soyad</label>
                    <span asp-validation-for="LastName" class="field-error"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="auth-row">
        <div class="field">
            <input asp-for="Email" type="email" placeholder=" " autocomplete="email" />
            <label asp-for="Email">E-posta</label>
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
    </div>

    <div class="auth-row">
        <div class="field">
            <input asp-for="Password" type="password" placeholder=" "
                   autocomplete="new-password" data-pw-strength />
            <label asp-for="Password">Şifre</label>
            <button type="button" class="peek" tabindex="-1" aria-label="Şifreyi göster"></button>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="pw-meter" data-score="0"><i></i><i></i><i></i><i></i></div>
        <div class="pw-hint">En az 6 karakter, bir rakam içermeli.</div>
    </div>

    <div class="auth-row">
        <div class="field">
            <input asp-for="ConfirmPassword" type="password" placeholder=" " autocomplete="new-password" />
            <label asp-for="ConfirmPassword">Şifre tekrar</label>
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
    </div>

    <button type="submit" class="auth-submit">
        <span class="label">Hesap oluştur</span>
        <span class="spin"></span>
    </button>

    <div class="auth-alt">
        Zaten hesabın var mı? <a asp-action="Login">Giriş yap</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}