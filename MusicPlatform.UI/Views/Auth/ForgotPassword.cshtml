@model MusicPlatform.UI.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = "_AuthLayout";
}

<h5>Şifreni mi unuttun?</h5>
<p class="text-muted my-3">
    E-posta adresini gir, şifreni nasıl sıfırlayacağını anlatan bir bağlantı gönderelim.
</p>

<form asp-action="ForgotPassword" method="post" class="mt-4">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" placeholder="ornek@mail.com" />
        <span asp-validation-for="Email" class="text-danger text-sm"></span>
    </div>

    <button type="submit" class="btn btn-primary btn-block mb-4">Bağlantı Gönder</button>

    <div>
        <a asp-action="Login" class="text-primary">Giriş sayfasına dön</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}