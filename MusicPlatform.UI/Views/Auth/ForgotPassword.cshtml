@model MusicPlatform.UI.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = "_AuthLayout";
}

<h2>Şifreni mi unuttun?</h2>
<div class="lede">
    E-posta adresini gir, şifreni nasıl sıfırlayacağını anlatan bir bağlantı gönderelim.
</div>

<form asp-action="ForgotPassword" method="post" data-auth-form>
    @Html.AntiForgeryToken()

    <div class="auth-row">
        <div class="field">
            <input asp-for="Email" type="email" placeholder=" " autocomplete="email" autofocus />
            <label asp-for="Email">E-posta</label>
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
    </div>

    <button type="submit" class="auth-submit">
        <span class="label">Bağlantı gönder</span>
        <span class="spin"></span>
    </button>

    <div class="auth-alt">
        <a asp-action="Login">Giriş sayfasına dön</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}