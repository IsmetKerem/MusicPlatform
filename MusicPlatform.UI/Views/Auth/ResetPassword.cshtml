@model MusicPlatform.UI.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Şifre Sıfırla";
    Layout = "_AuthLayout";
}

<h2>Yeni şifreni belirle</h2>
<div class="lede">Güçlü bir şifre seç ve kimseyle paylaşma.</div>

<form asp-action="ResetPassword" method="post" data-auth-form>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Token" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="auth-alert auth-alert-error">
            <div asp-validation-summary="ModelOnly"></div>
        </div>
    }

    <div class="auth-row">
        <div class="field">
            <input asp-for="NewPassword" type="password" placeholder=" "
                   autocomplete="new-password" data-pw-strength autofocus />
            <label asp-for="NewPassword">Yeni şifre</label>
            <button type="button" class="peek" tabindex="-1" aria-label="Şifreyi göster"></button>
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>
        <div class="pw-meter" data-score="0"><i></i><i></i><i></i><i></i></div>
    </div>

    <div class="auth-row">
        <div class="field">
            <input asp-for="ConfirmPassword" type="password" placeholder=" " autocomplete="new-password" />
            <label asp-for="ConfirmPassword">Şifre tekrar</label>
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
    </div>

    <button type="submit" class="auth-submit">
        <span class="label">Şifreyi güncelle</span>
        <span class="spin"></span>
    </button>

    <div class="auth-alt">
        <a asp-action="Login">Giriş sayfasına dön</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}