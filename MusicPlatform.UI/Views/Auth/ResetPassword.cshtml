@model MusicPlatform.UI.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Şifre Sıfırla";
    Layout = "_AuthLayout";
}

<h5>Yeni şifreni belirle</h5>
<p class="text-muted my-3">Güçlü bir şifre seç ve kimseyle paylaşma.</p>

<form asp-action="ResetPassword" method="post" class="mt-4">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Token" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 text-sm"></div>

    <div class="form-group">
        <label asp-for="NewPassword"></label>
        <input asp-for="NewPassword" class="form-control" placeholder="En az 6 karakter" />
        <span asp-validation-for="NewPassword" class="text-danger text-sm"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" class="form-control" placeholder="Şifrenizi tekrar girin" />
        <span asp-validation-for="ConfirmPassword" class="text-danger text-sm"></span>
    </div>

    <button type="submit" class="btn btn-primary btn-block mb-4">Şifreyi Güncelle</button>

    <div><a asp-action="Login" class="text-primary">Giriş sayfasına dön</a></div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}