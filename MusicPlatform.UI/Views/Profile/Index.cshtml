@model MusicPlatform.UI.Models.ProfilePageViewModel
@{
    ViewData["Title"] = "Profilim";
    var p = Model.Profile;
    var apiBase = ApiOptions.Value.BaseUrl;
}

<div class="page-container padding">
    <div class="row">

        @* ==================================================== SOL: Kimlik *@
        <div class="col-lg-4 mb-4">

            <div class="p-4 rounded bg-dark-overlay text-center">

                <div class="profile-avatar mx-auto mb-3">
                    @if (!string.IsNullOrEmpty(p.ProfileImageUrl))
                    {
                        <div class="profile-avatar-img" style="background-image:url('@apiBase@p.ProfileImageUrl')"></div>
                    }
                    else
                    {
                        <div class="profile-avatar-img letter-cover"
                             style="@CoverHelper.GradientStyle(p.FullName);font-size:2.4rem">
                            @CoverHelper.InitialsOf(p.FullName)
                        </div>
                    }
                </div>

                <h5 class="text-white mb-1">@p.FullName</h5>
                <div class="text-muted text-sm mb-3">@p.Email</div>

                <span class="badge badge-pill pkg-@p.PackageLevel px-3 py-2">@p.PackageName</span>

                @if (p.RemainingDays.HasValue)
                {
                    <div class="text-muted text-xs mt-2">@p.RemainingDays gün kaldı</div>
                }
                else if (p.PackageLevel == 1)
                {
                    <div class="text-muted text-xs mt-2">Ücretsiz paket</div>
                }

                <form asp-action="UploadAvatar" method="post" enctype="multipart/form-data" class="mt-4">
                    @Html.AntiForgeryToken()
                    <label class="btn btn-sm btn-outline-primary btn-rounded m-0">
                        Fotoğraf değiştir
                        <input type="file" name="file" accept="image/*" hidden
                               onchange="this.form.submit()" />
                    </label>
                </form>

                @if (p.PackageLevel < 4)
                {
                    <div class="mt-3">
                        <a asp-controller="Packages" asp-action="Index" class="text-primary text-sm">
                            Paketini yükselt
                        </a>
                    </div>
                }
            </div>

            @* ------------------------------------------------ Istatistikler *@
            <div class="p-4 rounded bg-dark-overlay mt-3">
                <h6 class="text-white mb-3">Dinleme istatistiklerin</h6>

                <div class="row text-center">
                    <div class="col-6 mb-3">
                        <div class="h4 text-white mb-0">@p.Stats.TotalListens</div>
                        <div class="text-muted text-xs">toplam dinleme</div>
                    </div>
                    <div class="col-6 mb-3">
                        <div class="h4 text-white mb-0">@p.Stats.DistinctSongs</div>
                        <div class="text-muted text-xs">farklı şarkı</div>
                    </div>
                    <div class="col-6">
                        <div class="h4 text-white mb-0">@p.Stats.TotalMinutes</div>
                        <div class="text-muted text-xs">dakika</div>
                    </div>
                    <div class="col-6">
                        <div class="h4 text-white mb-0">@p.Stats.FavoriteCount</div>
                        <div class="text-muted text-xs">favori</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(p.Stats.TopArtist) || !string.IsNullOrEmpty(p.Stats.TopGenre))
                {
                    <div class="border-top border-dark mt-3 pt-3">
                        @if (!string.IsNullOrEmpty(p.Stats.TopArtist))
                        {
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-muted text-sm">En çok dinlediğin sanatçı</span>
                                <span class="text-white text-sm">@p.Stats.TopArtist</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(p.Stats.TopGenre))
                        {
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-muted text-sm">En çok dinlediğin tür</span>
                                <span class="text-white text-sm">@p.Stats.TopGenre</span>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>

        @* ==================================================== SAG: Formlar *@
        <div class="col-lg-8">

            <div class="p-4 rounded bg-dark-overlay mb-3">
                <h6 class="text-white mb-4">Hesap bilgileri</h6>

                <form asp-action="Update" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Update.FirstName"></label>
                                <input asp-for="Update.FirstName" class="form-control" />
                                <span asp-validation-for="Update.FirstName" class="text-danger text-sm"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Update.LastName"></label>
                                <input asp-for="Update.LastName" class="form-control" />
                                <span asp-validation-for="Update.LastName" class="text-danger text-sm"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Update.BirthDate"></label>
                                <input asp-for="Update.BirthDate" type="date" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>E-posta</label>
                                <input value="@p.Email" class="form-control" disabled />
                                <small class="text-muted">E-posta adresi değiştirilemez.</small>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-rounded px-4">Kaydet</button>
                </form>
            </div>

            @* ----------------------------------------------- Sifre degistir *@
            <div class="p-4 rounded bg-dark-overlay mb-3">
                <h6 class="text-white mb-1">Şifre değiştir</h6>
                <p class="text-muted text-sm mb-4">
                    Şifreni değiştirdiğinde diğer cihazlardaki oturumların kapatılır.
                </p>

                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label asp-for="Password.CurrentPassword"></label>
                        <input asp-for="Password.CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password.CurrentPassword" class="text-danger text-sm"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Password.NewPassword"></label>
                                <input asp-for="Password.NewPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="Password.NewPassword" class="text-danger text-sm"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Password.ConfirmPassword"></label>
                                <input asp-for="Password.ConfirmPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="Password.ConfirmPassword" class="text-danger text-sm"></span>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-outline-primary btn-rounded px-4">Şifreyi Değiştir</button>
                </form>
            </div>

            @* -------------------------------------------------- Hesap ozeti *@
            <div class="p-4 rounded bg-dark-overlay">
                <h6 class="text-white mb-3">Hesap</h6>

                <div class="d-flex justify-content-between py-2 border-bottom border-dark">
                    <span class="text-muted text-sm">Üyelik tarihi</span>
                    <span class="text-white text-sm">@p.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy")</span>
                </div>

                @if (p.LastLoginAt.HasValue)
                {
                    <div class="d-flex justify-content-between py-2 border-bottom border-dark">
                        <span class="text-muted text-sm">Son giriş</span>
                        <span class="text-white text-sm">@p.LastLoginAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                }

                <div class="d-flex justify-content-between py-2">
                    <span class="text-muted text-sm">Playlist sayısı</span>
                    <span class="text-white text-sm">@p.Stats.PlaylistCount</span>
                </div>
            </div>

        </div>
    </div>
</div>

@section Styles {
    <style>
        .profile-avatar { width: 120px; height: 120px; }
        .profile-avatar-img {
            width: 100%; height: 100%;
            border-radius: 50%;
            background-size: cover; background-position: center;
            background-color: #241f38;
            display: flex; align-items: center; justify-content: center;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}