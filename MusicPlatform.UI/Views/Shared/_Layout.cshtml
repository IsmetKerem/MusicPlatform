@using MusicPlatform.UI.Services
@inject CurrentUser CurrentUser
@inject ITokenStore TokenStore

<!DOCTYPE html>
<html lang="tr" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <title>@ViewData["Title"] - MusicPlatform</title>

    <link rel="stylesheet" href="~/Bepop/libs/slick-carousel/slick/slick.css" />
    <link rel="stylesheet" href="~/Bepop/libs/slick-carousel/slick/slick-theme.css" />
    <link rel="stylesheet" href="~/Bepop/assets/css/bootstrap.css" />
    <link rel="stylesheet" href="~/Bepop/assets/css/theme.css" />
    <link rel="stylesheet" href="~/Bepop/assets/css/style.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="layout-column bg-dark">

<header id="header" class="page-header fixed">
    <div class="navbar navbar-expand-lg">

        <a asp-controller="Home" asp-action="Index" class="navbar-brand text-white">
            <svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1" fill="#000"></circle>
                <circle cx="12" cy="12" r="2" stroke="currentColor" stroke-width="1"></circle>
                <g class="loading-spin" stroke="currentColor" stroke-width="1" style="transform-origin: 12px 12px">
                    <path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"></path>
                </g>
            </svg>
            <span class="hidden-folded d-inline l-s-n-1x">MusicPlatform</span>
        </a>

        <div class="collapse navbar-collapse order-2 order-lg-1" id="navbarCollapse">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a asp-controller="Home" asp-action="Index" class="nav-link">
                        <span class="nav-text">Keşfet</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Songs" asp-action="Index" class="nav-link">
                        <span class="nav-text">Şarkılar</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Artists" asp-action="Index" class="nav-link">
                        <span class="nav-text">Sanatçılar</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Genres" asp-action="Index" class="nav-link">
                        <span class="nav-text">Türler</span>
                    </a>
                </li>
            </ul>
        </div>

        <ul class="nav navbar-menu order-1 order-lg-2">

            @if (TokenStore.IsAuthenticated)
            {
                <li class="nav-item d-none d-sm-block">
                    <form asp-controller="Songs" asp-action="Index" method="get" class="m-0">
                        <div class="input-group">
                            <input type="text" name="search" class="form-control form-control-sm bg-dark-overlay border-0"
                                   placeholder="Şarkı veya sanatçı ara..." style="min-width:200px" />
                        </div>
                    </form>
                </li>

                <li class="nav-item">
                    <span class="badge badge-pill badge-@PackageBadge(CurrentUser.PackageLevel) mx-2">
                        @CurrentUser.PackageName
                    </span>
                </li>

                <li class="nav-item dropdown">
                    <a href="#" class="nav-link d-flex align-items-center px-2" data-toggle="dropdown">
                        <span class="avatar w-24 bg-primary text-white">
                            @(CurrentUser.FullName.Length > 0 ? CurrentUser.FullName[0].ToString().ToUpper() : "K")
                        </span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-right mt-3">
                        <div class="dropdown-header px-3 py-2">
                            <div class="text-white">@CurrentUser.FullName</div>
                            <small class="text-muted">@CurrentUser.Email</small>
                        </div>
                        <div class="dropdown-divider"></div>
                        <a asp-controller="Profile" asp-action="Index" class="dropdown-item">Profilim</a>
                        <a asp-controller="Favorites" asp-action="Index" class="dropdown-item">Favorilerim</a>
                        <a asp-controller="Playlists" asp-action="Index" class="dropdown-item">Playlistlerim</a>
                        <a asp-controller="Packages" asp-action="Index" class="dropdown-item">Paketim</a>
                        <div class="dropdown-divider"></div>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger">Çıkış Yap</button>
                        </form>
                    </div>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <a asp-controller="Auth" asp-action="Login" class="nav-link">Giriş</a>
                </li>
                <li class="d-flex align-items-center">
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-rounded btn-sm btn-primary">Kayıt Ol</a>
                </li>
            }

            <li class="nav-item d-lg-none">
                <a href="#" class="nav-link px-2" data-toggle="collapse" data-target="#navbarCollapse">
                    <i data-feather="menu"></i>
                </a>
            </li>
        </ul>
    </div>
</header>

<div id="main" class="layout-row flex">
    <div id="content" class="flex">

        @if (TempData["Success"] is string success)
        {
            <div class="page-container pt-3">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @success
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
            </div>
        }

        @if (TempData["Error"] is string error)
        {
            <div class="page-container pt-3">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @error
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
            </div>
        }

        @RenderBody()
    </div>
</div>

@* ---------------------------------------------- Paket uyari popup'i *@
<div class="modal fade" id="packageModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content bg-dark">
            <div class="modal-body text-center p-5">
                <div class="mb-4">
                    <span class="w-64 avatar bg-warning-lt text-warning circle">
                        <i data-feather="lock" style="width:28px;height:28px"></i>
                    </span>
                </div>
                <h5 class="mb-3 text-white" id="packageModalTitle">Bu şarkı paketinizde yok</h5>
                <p class="text-muted mb-4" id="packageModalMessage">
                    Mevcut paketiniz bu şarkıyı desteklememektedir. Lütfen paketinizi yükseltin.
                </p>
                <div class="d-flex justify-content-center align-items-center mb-4" id="packageModalDetail"></div>
                <a asp-controller="Packages" asp-action="Index" class="btn btn-primary btn-rounded px-5">
                    Paketleri İncele
                </a>
                <div class="mt-3">
                    <button type="button" class="btn btn-sm text-muted" data-dismiss="modal">Vazgeç</button>
                </div>
            </div>
        </div>
    </div>
</div>

@* ---------------------------------------------------------- Player *@
@if (TokenStore.IsAuthenticated)
{
    <div id="mp-player" class="mp-player">
        <audio preload="metadata"></audio>

        <div class="mp-player-inner">

            <div class="mp-now d-flex align-items-center">
                <div class="mp-cover"></div>
                <div class="mp-meta ml-3 text-ellipsis">
                    <div class="mp-title text-white text-ellipsis">Bir şarkı seçin</div>
                    <div class="mp-artist text-muted text-sm text-ellipsis">—</div>
                </div>
            </div>

            <div class="mp-controls">
                <div class="d-flex align-items-center justify-content-center">
                    <button class="mp-prev btn btn-icon btn-sm" type="button" title="Önceki">
                        <i data-feather="skip-back"></i>
                    </button>
                    <button class="mp-play btn btn-icon btn-rounded btn-primary mx-3" type="button" title="Çal / Duraklat">
                        <i data-feather="play"></i>
                    </button>
                    <button class="mp-next btn btn-icon btn-sm" type="button" title="Sonraki">
                        <i data-feather="skip-forward"></i>
                    </button>
                </div>

                <div class="d-flex align-items-center mt-1">
                    <span class="mp-current text-xs text-muted">0:00</span>
                    <input type="range" class="mp-seek custom-range mx-2" min="0" max="100" value="0" />
                    <span class="mp-duration text-xs text-muted">0:00</span>
                </div>
            </div>

            <div class="mp-extra d-none d-md-flex align-items-center justify-content-end">
                <i data-feather="volume-2" class="text-muted mr-2" style="width:16px;height:16px"></i>
                <input type="range" class="mp-volume custom-range" min="0" max="100" value="100" style="max-width:90px" />
            </div>

        </div>
    </div>
}

<script src="~/Bepop/libs/jquery/dist/jquery.min.js"></script>
<script src="~/Bepop/libs/popper.js/dist/umd/popper.min.js"></script>
<script src="~/Bepop/libs/bootstrap/dist/js/bootstrap.min.js"></script>
<script src="~/Bepop/libs/feather-icons/dist/feather.min.js"></script>
<script src="~/js/app.js" asp-append-version="true"></script>
<script src="~/js/player.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>

@functions {
    string PackageBadge(int level) => level switch
    {
        4 => "warning",
        3 => "info",
        2 => "success",
        _ => "secondary"
    };
}